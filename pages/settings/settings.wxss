.page { min-height: 100vh; box-sizing: border-box; padding: 42rpx 32rpx; background: #fdfbfb; color: #334033; }.section-title { margin: 24rpx 8rpx 20rpx; color: #596f58; font-size: 26rpx; }.card { overflow: hidden; border-radius: 20rpx; background: #fff; box-shadow: 0 4rpx 16rpx rgba(51, 64, 51, .05); }.item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 26rpx; border-bottom: 1rpx solid #eef1eb; font-size: 30rpx; }.item:last-child { border-bottom: 0; }.muted { margin-top: 9rpx; color: #5b6b59; font-size: 24rpx; line-height: 1.5; }.action, .arrow { color: #4d6a4d; font-size: 26rpx; }.arrow { font-size: 40rpx; }.about { padding: 30rpx 26rpx; color: #536351; font-size: 27rpx; line-height: 1.8; }
