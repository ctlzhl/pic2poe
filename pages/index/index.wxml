<view class="page">
  <view class="hero">
    <view class="eyebrow">照片有话说</view>
    <view class="title">把此刻，写下来</view>
    <view class="subtitle">上传一张照片，选择你想听见的话。</view>
    <view class="works-link" bindtap="goWorks">前往我的作品 →</view>
  </view>

  <view class="image-card" bindtap="chooseImage">
    <image wx:if="{{imageUrl}}" class="preview" src="{{imageUrl}}" mode="aspectFit"></image>
    <view wx:else class="image-empty">
      <view class="empty-icon">◌</view>
      <view class="empty-title">选择一张照片</view>
      <view class="empty-desc">支持 JPG、PNG、WebP，最大 6MB</view>
    </view>
    <view wx:if="{{preparing}}" class="image-status">正在优化图片…</view>
    <view wx:elif="{{prepareState === 'ready'}}" class="image-status ready">图片已准备好</view>
    <view wx:if="{{imageUrl && !preparing}}" class="change-mask">点击更换图片</view>
  </view>

  <button wx:if="{{!imageUrl}}" class="secondary-button" loading="{{preparing}}" disabled="{{preparing || submitting}}" bindtap="chooseImage">上传图片</button>

  <view wx:if="{{!imageUrl}}" class="guide-card">
    <view class="guide-title">三步开始创作</view>
    <view class="guide-item"><text>1</text>补充照片背后的故事</view>
    <view class="guide-item"><text>2</text>选择想生成的内容类型</view>
    <view class="guide-item"><text>3</text>生成并保存你的作品</view>
  </view>

  <view wx:if="{{assetId}}" class="creation-form">
    <view class="section">
      <view class="section-label">需要生成的类型</view>
      <view class="type-list">
        <view wx:for="{{generateTypes}}" wx:key="value" class="type-item {{generateType === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectGenerateType">
          <view class="type-title">{{item.title}}</view>
          <view class="type-desc">{{item.description}}</view>
        </view>
      </view>
    </view>

    <view class="section compact-section">
      <view class="section-label">这是在哪里？<text>可选</text></view>
      <input class="text-input" maxlength="60" placeholder="例如：杭州西湖" value="{{location}}" bindinput="updateLocation" />
    </view>

    <view class="section compact-section">
      <view class="section-label">这一刻发生了什么？<text>可选</text></view>
      <input class="text-input" maxlength="140" placeholder="此刻的心情或想说的话" value="{{moment}}" bindinput="updateMoment" />
    </view>

    <view class="section compact-section">
      <view class="section-label">想要的感觉？<text>可选</text></view>
      <view class="mood-list">
        <view wx:for="{{moods}}" wx:key="value" class="mood {{mood === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectMood">{{item.title}}</view>
      </view>
    </view>

    <button class="primary-button" loading="{{submitting}}" disabled="{{preparing || submitting || !assetId}}" bindtap="startCreation">开始生成</button>
  </view>
</view>
