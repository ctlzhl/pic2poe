<!--index.wxml-->
<view class="container">
  <!-- 头部标题 -->
  <view class="header">
    <view class="title">拍照成诗</view>
    <view class="subtitle">让每一张照片都成为诗</view>
  </view>

  <!-- 主内容区 -->
  <view class="main-content" bindtap="handleMainTap">
    <!-- 预览图片区域 -->
    <view class="image-preview" wx:if="{{imageUrl}}">
      <image src="{{imageUrl}}" mode="aspectFit" class="preview-img"></image>
      <view class="image-mask">
        <text class="change-btn" bindtap="chooseImage">更换图片</text>
      </view>
    </view>

    <!-- 占位图 -->
    <view class="image-placeholder" wx:else>
      <image class="placeholder-img" src="/static/img/placeholder-upload.png" mode="aspectFit"></image>
      <text class="placeholder-text">选择一张照片开始创作</text>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="btn-primary" catchtap="chooseImage" wx:if="{{!imageUrl}}">
        <text class="btn-icon">📷</text>
        <text class="btn-text">选择照片</text>
      </button>
      
      <button class="btn-primary" catchtap="generatePoem" wx:if="{{imageUrl}}">
        <text class="btn-icon">✨</text>
        <text class="btn-text">开始创作</text>
      </button>
    </view>

    <!-- 引导提示 -->
    <view class="guide-card" catchtap="noop">
      <view class="guide-title">三步开启诗意创作</view>
      <view class="guide-list">
        <view class="guide-item" wx:for="{{guideList}}" wx:key="title">
          <view class="guide-index">{{index + 1}}</view>
          <view class="guide-content">
            <view class="guide-item-title">{{item.title}}</view>
            <view class="guide-item-desc">{{item.desc}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>


</view>
