<view class="page">
  <view class="hero">
    <view class="eyebrow">照片有话说</view>
    <view class="title ui-page-title">把此刻，写下来</view>
    <view class="subtitle">上传一张照片，选择你想听见的话。</view>
  </view>

  <view class="image-card" role="button" aria-label="选择一张照片" bindtap="chooseImage">
    <image wx:if="{{imageUrl}}" class="preview" src="{{imageUrl}}" mode="aspectFit"></image>
    <view wx:else class="image-empty">
      <image class="empty-background" src="/assets/images/creation-upload-v1.jpg" mode="aspectFill"></image>
      <view class="empty-overlay"></view>
      <view class="empty-content">
        <view class="empty-icon">＋</view>
        <view class="empty-title">选择一张照片</view>
        <view class="empty-desc">支持 JPG、PNG、WebP，最大 6MB</view>
      </view>
    </view>
    <view wx:if="{{preparing}}" class="image-status">{{prepareMessage || '正在准备图片…'}}</view>
    <view wx:elif="{{prepareState === 'ready'}}" class="image-status ready">图片已准备好</view>
    <view wx:elif="{{prepareState === 'error'}}" class="image-status error">{{prepareMessage}}</view>
    <view wx:if="{{imageUrl && !preparing}}" class="change-mask">点击更换图片</view>
  </view>

  <view wx:if="{{!imageUrl}}" class="creation-steps" aria-label="选图、选类型、创作">
    <view>选图</view><text>→</text><view>选类型</view><text>→</text><view>创作</view>
  </view>

  <view wx:if="{{!imageUrl}}" class="type-preview">
    <view class="type-preview-heading">一张照片，三种表达</view>
    <view class="type-preview-note">选好照片，再决定怎么写。</view>
    <view wx:for="{{generateTypes}}" wx:key="value" class="type-preview-row">
      <view class="type-preview-title">{{item.title}}</view>
      <view class="type-preview-description">{{item.description}}</view>
    </view>
  </view>

  <view wx:if="{{showCreationForm}}" class="creation-form">
    <view class="section">
      <view class="section-label">选择想要的类型</view>
      <view class="type-list">
        <view wx:for="{{generateTypes}}" wx:key="value" class="type-item {{generateType === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectGenerateType">
          <view class="type-title">{{item.title}}<text wx:if="{{generateType === item.value}}" class="selected-mark">✓</text></view>
          <view class="type-desc">{{item.description}}</view>
        </view>
      </view>
    </view>

    <view class="section compact-section">
      <view class="section-label">这是在哪里？<text>可选</text></view>
      <input class="text-input {{focusedField === 'location' ? 'is-focused' : ''}}" maxlength="60" placeholder="例如：杭州西湖" placeholder-style="color:#697668" value="{{location}}" data-field="location" bindfocus="onFieldFocus" bindblur="onFieldBlur" bindinput="updateLocation" />
    </view>

    <view class="section compact-section">
      <view class="section-label">这一刻发生了什么？<text>可选</text></view>
      <input class="text-input {{focusedField === 'moment' ? 'is-focused' : ''}}" maxlength="140" placeholder="此刻的心情或想说的话" placeholder-style="color:#697668" value="{{moment}}" data-field="moment" bindfocus="onFieldFocus" bindblur="onFieldBlur" bindinput="updateMoment" />
    </view>

    <view class="section compact-section">
      <view class="section-label">想要的感觉？<text>可选</text></view>
      <view class="mood-list">
        <view wx:for="{{moods}}" wx:key="value" class="mood {{mood === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="selectMood"><text wx:if="{{mood === item.value}}" class="mood-check">✓</text>{{item.title}}</view>
      </view>
    </view>

  </view>

  <view wx:if="{{showCreationForm}}" class="creation-action-bar">
    <button class="ui-button ui-button-primary" loading="{{submitting}}" disabled="{{preparing || submitting || !assetId}}" bindtap="startCreation">开始创作</button>
  </view>
</view>
