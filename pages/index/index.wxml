<!--index.wxml-->
<view class="container">
  <!-- 头部标题 -->
  <view class="header">
    <view class="title">图生诗境</view>
    <view class="subtitle">让每一张照片都成为诗</view>
  </view>

  <!-- 主内容区 -->
  <view class="main-content">
    <!-- 预览图片区域 -->
    <view class="image-preview" wx:if="{{imageUrl}}">
      <image src="{{imageUrl}}" mode="aspectFit" class="preview-img"></image>
      <view class="image-mask">
        <text class="change-btn" bindtap="chooseImage">更换图片</text>
      </view>
    </view>

    <!-- 占位图 -->
    <view class="image-placeholder" wx:else>
      <view class="placeholder-icon">📷</view>
      <text class="placeholder-text">选择一张照片开始创作</text>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="btn-primary" bindtap="chooseImage" wx:if="{{!imageUrl}}">
        <text class="btn-icon">📷</text>
        <text class="btn-text">选择照片</text>
      </button>
      
      <button class="btn-primary" bindtap="generatePoem" wx:if="{{imageUrl}}" loading="{{loading}}">
        <text class="btn-icon">✨</text>
        <text class="btn-text">{{loading ? '创作中...' : '开始创作'}}</text>
      </button>
    </view>

    <!-- 示例展示 -->
    <view class="examples" wx:if="{{!imageUrl}}">
      <view class="example-title">创作示例</view>
      <view class="example-list">
        <view class="example-item" wx:for="{{examples}}" wx:key="index">
          <view class="example-img">🏔️</view>
          <view class="example-poem">{{item.poem}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部说明 -->
  <view class="footer">
    <text class="footer-text">由智谱AI倾情创作 · 每张照片都独一无二</text>
  </view>
</view>
