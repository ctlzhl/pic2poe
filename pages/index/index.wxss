page { background: #f8f7f2; color: #20251f; }
.page { padding: 52rpx 32rpx 64rpx; }
.hero { margin: 6rpx 0 44rpx; }
.eyebrow { color: #76826d; font-size: 24rpx; letter-spacing: 5rpx; }
.title { margin-top: 16rpx; font-family: serif; font-size: 56rpx; font-weight: 600; letter-spacing: 2rpx; }
.subtitle { margin-top: 14rpx; color: #74786f; font-size: 28rpx; }
.image-card { position: relative; height: 530rpx; overflow: hidden; border-radius: 28rpx; background: #e7e6dd; box-shadow: 0 16rpx 38rpx rgba(45, 51, 37, 0.12); }
.preview { width: 100%; height: 100%; }
.image-empty { position: relative; height: 100%; display: flex; align-items: center; justify-content: center; color: #74786f; }
.empty-background { position: absolute; inset: 0; width: 100%; height: 100%; }
.empty-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(34, 42, 31, 0.08), rgba(34, 42, 31, 0.02) 46%, rgba(34, 42, 31, 0.1)); }
.empty-content { position: relative; display: flex; flex-direction: column; align-items: center; color: #374034; text-align: center; text-shadow: 0 2rpx 12rpx rgba(255, 253, 247, 0.85); }
.empty-icon { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #486348; border-radius: 50%; background: #486348; box-shadow: 0 10rpx 24rpx rgba(40, 59, 39, 0.22); color: #fff; font-size: 56rpx; font-weight: 300; line-height: 1; }
.empty-title { margin-top: 22rpx; font-size: 34rpx; font-weight: 500; color: #374034; }
.empty-desc { margin-top: 14rpx; color: #556052; font-size: 24rpx; }
.image-status { position: absolute; left: 0; right: 0; bottom: 0; padding: 18rpx 24rpx; background: rgba(29, 36, 28, 0.7); color: #fff; font-size: 25rpx; text-align: center; }
.image-status.ready { background: rgba(64, 99, 70, 0.86); }
.change-mask { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(24, 31, 24, .34); color: #fff; font-size: 28rpx; opacity: 0; }
.image-card:active .change-mask { opacity: 1; }
.secondary-button, .primary-button { display: flex; align-items: center; justify-content: center; width: 100%; height: 96rpx; padding: 0; line-height: 1; border-radius: 48rpx; font-size: 30rpx; }
.secondary-button { margin: 28rpx 0 46rpx; background: #fff; color: #4d5b48; border: 1rpx solid #d5d9cf; }
.secondary-button::after, .primary-button::after { border: none; }
.primary-button { margin-top: 52rpx; background: #4a684c; color: #fff; box-shadow: 0 12rpx 28rpx rgba(48, 80, 51, 0.24); }
.primary-button[disabled] { background: #aeb8aa; color: #edf0ea; }
.section { margin-top: 36rpx; }
.compact-section { margin-top: 32rpx; }
.section-label { margin-bottom: 18rpx; color: #31382e; font-size: 28rpx; font-weight: 600; }
.section-label text { margin-left: 8rpx; color: #969b93; font-size: 22rpx; font-weight: 400; }
.type-list { display: flex; gap: 16rpx; }
.type-item { flex: 1; min-height: 142rpx; padding: 22rpx 16rpx; box-sizing: border-box; border: 2rpx solid #e1e4dc; border-radius: 18rpx; background: #fff; }
.type-item.selected { border-color: #59755b; background: #f0f5ee; }
.type-title { font-size: 30rpx; font-weight: 600; }
.type-desc { margin-top: 10rpx; color: #7c8178; font-size: 22rpx; line-height: 1.45; }
.mood-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.mood { padding: 14rpx 24rpx; border: 2rpx solid #e1e4dc; border-radius: 32rpx; color: #676e64; background: #fff; font-size: 26rpx; }
.mood.selected { border-color: #59755b; color: #476148; background: #edf4eb; }
.text-input { width: 100%; box-sizing: border-box; border-radius: 16rpx; background: #fff; border: 1rpx solid #e1e4dc; color: #2d332b; font-size: 28rpx; }
.text-input { height: 88rpx; padding: 0 24rpx; }
.guide-card { margin-top: 40rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; color: #687064; font-size: 26rpx; line-height: 2.1; }
.guide-title { color: #31382e; font-size: 30rpx; font-weight: 600; }
.guide-item text { display: inline-flex; width: 36rpx; height: 36rpx; margin-right: 14rpx; align-items: center; justify-content: center; border-radius: 50%; background: #edf4eb; color: #4a684c; font-size: 22rpx; }
