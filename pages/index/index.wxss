page { background: #f8f7f2; color: #20251f; }
.page { padding: 40rpx 32rpx 64rpx; }
.hero { margin: 6rpx 0 32rpx; }
.eyebrow { color: #627460; font-size: 24rpx; letter-spacing: 5rpx; }
.title { margin-top: 16rpx; }
.subtitle { margin-top: 14rpx; color: #596658; font-size: 28rpx; }
.image-card { position: relative; height: 450rpx; overflow: hidden; border-radius: 24rpx; background: #e7e6dd; box-shadow: 0 8rpx 24rpx rgba(45, 51, 37, 0.09); }
.preview { width: 100%; height: 100%; }
.image-empty { position: relative; height: 100%; display: flex; align-items: center; justify-content: center; color: #74786f; }
.empty-background { position: absolute; inset: 0; width: 100%; height: 100%; }
.empty-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(34, 42, 31, 0.08), rgba(34, 42, 31, 0.02) 46%, rgba(34, 42, 31, 0.1)); }
.empty-content { position: relative; display: flex; flex-direction: column; align-items: center; color: #374034; text-align: center; text-shadow: 0 2rpx 12rpx rgba(255, 253, 247, 0.85); }
.empty-icon { display: flex; width: 88rpx; height: 88rpx; align-items: center; justify-content: center; box-sizing: border-box; border: 2rpx solid #486348; border-radius: 50%; background: #486348; box-shadow: 0 10rpx 24rpx rgba(40, 59, 39, 0.22); color: #fff; font-size: 56rpx; font-weight: 300; line-height: 1; }
.empty-title { margin-top: 22rpx; font-size: 34rpx; font-weight: 500; color: #374034; }
.empty-desc { margin-top: 14rpx; color: #556052; font-size: 24rpx; }
.image-status { position: absolute; left: 0; right: 0; bottom: 0; padding: 18rpx 24rpx; background: rgba(29, 36, 28, 0.7); color: #fff; font-size: 25rpx; text-align: center; }
.image-status.ready { background: rgba(64, 99, 70, 0.86); }
.image-status.error { background: rgba(114, 61, 51, 0.86); }
.change-mask { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(24, 31, 24, .34); color: #fff; font-size: 28rpx; opacity: 0; }
.image-card:active .change-mask { opacity: 1; }
.creation-steps { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin-top: 30rpx; color: #50664f; font-size: 25rpx; }
.creation-steps text { color: #83917f; }
.creation-form { padding-bottom: 136rpx; }
.creation-action-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 30; padding: 16rpx 32rpx 12rpx; box-sizing: border-box; background: rgba(248, 247, 242, 0.98); box-shadow: 0 -10rpx 26rpx rgba(48, 56, 43, 0.08); }
.section { margin-top: 36rpx; }
.compact-section { margin-top: 32rpx; }
.section-label { margin-bottom: 18rpx; color: #31382e; font-size: 28rpx; font-weight: 600; }
.section-label text { margin-left: 8rpx; color: #647260; font-size: 24rpx; font-weight: 400; }
.type-list { display: flex; gap: 16rpx; }
.type-item { flex: 1; min-height: 142rpx; padding: 22rpx 16rpx; box-sizing: border-box; border: 2rpx solid #d6dfd2; border-radius: 18rpx; background: #fff; }
.type-item.selected { border-color: #4a684c; background: #edf4eb; }
.type-title { font-size: 30rpx; font-weight: 600; }
.selected-mark { margin-left: 8rpx; color: #3e6843; font-size: 24rpx; }
.type-desc { margin-top: 10rpx; color: #5e6b5b; font-size: 24rpx; line-height: 1.45; }
.mood-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.mood { padding: 14rpx 24rpx; border: 2rpx solid #d6dfd2; border-radius: 32rpx; color: #596658; background: #fff; font-size: 26rpx; }
.mood.selected { border-color: #59755b; color: #476148; background: #edf4eb; }
.mood-check { margin-right: 6rpx; font-size: 22rpx; font-weight: 700; }
.text-input { width: 100%; box-sizing: border-box; border-radius: 16rpx; background: #fff; border: 2rpx solid #d6dfd2; color: #2d332b; font-size: 28rpx; }
.text-input { height: 88rpx; padding: 0 24rpx; }
.text-input.is-focused { border-color: #4a684c; box-shadow: 0 0 0 4rpx rgba(74, 104, 76, 0.12); }
