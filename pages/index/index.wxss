/**index.wxss**/
page {
  height: 100vh;
  background: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
}

/* 头部 */
.header {
  text-align: center;
  margin-bottom: 60rpx;
  margin-top: 40rpx;
}

.title {
  font-size: 56rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  letter-spacing: 2rpx;
}

/* 主内容区 */
.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 图片预览 */
.image-preview {
  width: 100%;
  height: 600rpx;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 40rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.image-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.image-preview:active .image-mask {
  opacity: 1;
}

.change-btn {
  color: #fff;
  font-size: 32rpx;
  padding: 16rpx 32rpx;
  border: 2rpx solid #fff;
  border-radius: 48rpx;
}

/* 占位图 */
.image-placeholder {
  width: 100%;
  height: 600rpx;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
  margin-bottom: 40rpx;
}

.placeholder-icon {
  width: 160rpx;
  opacity: 0.3;
  margin-bottom: 24rpx;
}

.placeholder-text {
  color: #999;
  font-size: 28rpx;
}

/* 按钮 */
.action-buttons {
  width: 100%;
  margin-bottom: 60rpx;
}

.btn-primary {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.btn-text {
  font-weight: 500;
}

/* 引导提示 */
.guide-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.18);
  margin-top: 20rpx;
}

.guide-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 28rpx;
  text-align: center;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
}

.guide-index {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 26rpx;
}

.guide-content {
  flex: 1;
  margin-left: 24rpx;
}

.guide-item-title {
  font-size: 30rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.guide-item-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 40rpx 0;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}
