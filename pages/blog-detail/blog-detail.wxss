page { background: #fffdf9; }.page { min-height: 100vh; padding-bottom: 80rpx; color: #30372e; }.hero { width: 100%; height: 460rpx; background: #e6ebe3; }.category { margin: 46rpx 42rpx 0; color: #7b8875; font-size: 24rpx; }.title { margin: 20rpx 42rpx 0; font-family: serif; font-size: 48rpx; font-weight: 600; line-height: 1.32; }.content { display: block; margin: 42rpx; color: #4c5549; font-size: 31rpx; line-height: 1.9; }.primary-button { width: calc(100% - 84rpx); margin: 36rpx 42rpx 0; border-radius: 999rpx; background: #4a684c; color: #fff; font-size: 30rpx; }.primary-button::after { border: 0; }.state { padding: 160rpx 30rpx; color: #7c8578; font-size: 28rpx; text-align: center; }.retry { margin-top: 22rpx; color: #4f704f; }
