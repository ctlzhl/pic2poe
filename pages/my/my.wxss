.page { min-height: 100vh; box-sizing: border-box; padding: 48rpx 32rpx 140rpx; background: #fdfbfb; color: #334033; }
.profile { display: flex; align-items: center; padding: 22rpx 8rpx 58rpx; }
.profile-info { min-width: 0; margin-left: 8rpx; }
.avatar-button { width: 92rpx; min-width: 0; height: 92rpx; flex: 0 0 92rpx; margin: 0; padding: 0; border: 0; background: transparent; line-height: 1; }
.avatar-button::after { border: none; }
.avatar { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: #dbe7d5; color: #426044; flex: 0 0 92rpx; }
.profile-name-input { width: 390rpx; height: 54rpx; padding: 0; color: #334033; font-size: 35rpx; font-weight: 700; line-height: 54rpx; }
.profile-copy { margin-top: 8rpx; color: #849083; font-size: 25rpx; }
.settings { margin-left: auto; color: #5e745e; font-size: 28rpx; }
.guest-profile { min-height: 48vh; display: flex; align-items: center; justify-content: center; text-align: center; }
.privacy-copy { padding: 24rpx 32rpx; border-radius: 24rpx; background: #f4f6f1; color: #7f8b7d; font-size: 24rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; font-size: 34rpx; font-weight: 700; }.all-link { color: #5e745e; font-size: 27rpx; font-weight: 400; }.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }.card { min-width: 0; overflow: hidden; border-radius: 20rpx; background: #f4f6f1; }.thumb { width: 100%; height: 220rpx; background: #e7ece4; }.placeholder { display: flex; align-items: center; justify-content: center; color: #91a08d; }.card-type, .card-title, .card-date { padding: 0 18rpx; }.card-type { margin-top: 18rpx; color: #74826f; font-size: 22rpx; }.card-title { margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 700; }.card-date { padding-bottom: 18rpx; margin-top: 12rpx; color: #849083; font-size: 22rpx; }.state { padding: 120rpx 20rpx; text-align: center; color: #6e7b6c; }.empty-title { margin-bottom: 34rpx; font-size: 31rpx; }.primary-button { display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1; background: #4a684c; color: #fff; border-radius: 999rpx; font-size: 30rpx; }.text-button { color: #4a684c; background: transparent; }.text-button::after, .primary-button::after { border: 0; }
