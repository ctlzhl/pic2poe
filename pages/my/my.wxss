.page { min-height: 100vh; box-sizing: border-box; padding: 48rpx 32rpx 140rpx; background: #fdfbfb; color: #334033; }.profile { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 8rpx 58rpx; }.avatar { width: 92rpx; height: 92rpx; border-radius: 50%; background: #dbe7d5; color: #426044; }.profile > .avatar { flex: 0 0 92rpx; }.profile-name { font-size: 35rpx; font-weight: 700; }.profile-copy { margin-top: 8rpx; color: #849083; font-size: 25rpx; }.settings { margin-left: auto; color: #5e745e; font-size: 28rpx; }.login-card { display: flex; min-height: 68vh; padding: 30rpx; box-sizing: border-box; align-items: center; flex-direction: column; justify-content: center; text-align: center; }.placeholder-avatar { display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 700; }.login-title { margin-top: 36rpx; font-size: 37rpx; font-weight: 700; }.login-copy { margin-top: 18rpx; color: #7d887b; font-size: 27rpx; line-height: 1.7; }.authorize-button { width: 100%; margin-top: 48rpx; border-radius: 999rpx; background: #4a684c; color: #fff; font-size: 30rpx; }.authorize-button::after, .primary-button::after { border: 0; }.privacy-copy { margin-top: 26rpx; color: #9aa39a; font-size: 22rpx; }.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; font-size: 34rpx; font-weight: 700; }.all-link { color: #5e745e; font-size: 27rpx; font-weight: 400; }.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }.card { min-width: 0; overflow: hidden; border-radius: 20rpx; background: #f4f6f1; }.thumb { width: 100%; height: 220rpx; background: #e7ece4; }.placeholder { display: flex; align-items: center; justify-content: center; color: #91a08d; }.card-type, .card-title, .card-date { padding: 0 18rpx; }.card-type { margin-top: 18rpx; color: #74826f; font-size: 22rpx; }.card-title { margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 700; }.card-date { padding-bottom: 18rpx; margin-top: 12rpx; color: #849083; font-size: 22rpx; }.state { padding: 120rpx 20rpx; text-align: center; color: #6e7b6c; }.empty-title { margin-bottom: 34rpx; font-size: 31rpx; }.primary-button { background: #4a684c; color: #fff; border-radius: 999rpx; font-size: 30rpx; }.text-button { color: #4a684c; background: transparent; }.text-button::after { border: 0; }
