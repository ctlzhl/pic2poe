.page { min-height: 100vh; box-sizing: border-box; padding: 48rpx 32rpx 140rpx; background: #fdfbfb; color: #334033; }
.profile, .profile-tap { display: flex; align-items: center; }
.profile { justify-content: space-between; padding: 22rpx 8rpx 58rpx; }
.profile-tap { min-width: 0; gap: 20rpx; }
.profile-info { min-width: 0; }
.avatar { display: flex; width: 92rpx; height: 92rpx; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: #dbe7d5; color: #426044; flex: 0 0 92rpx; }
.profile-name { overflow: hidden; font-size: 35rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.profile-copy { margin-top: 8rpx; color: #849083; font-size: 25rpx; }
.settings { margin-left: auto; color: #5e745e; font-size: 28rpx; }
.guest-profile { min-height: 68vh; padding: 30rpx; box-sizing: border-box; display: flex; align-items: center; flex-direction: column; justify-content: center; text-align: center; }
.guest-profile .profile-tap { width: 100%; padding: 30rpx; box-sizing: border-box; border-radius: 24rpx; background: #f4f6f1; text-align: left; }
.placeholder-avatar { font-size: 40rpx; font-weight: 700; }
.privacy-copy { margin-top: 26rpx; color: #9aa39a; font-size: 22rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; font-size: 34rpx; font-weight: 700; }.all-link { color: #5e745e; font-size: 27rpx; font-weight: 400; }.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }.card { min-width: 0; overflow: hidden; border-radius: 20rpx; background: #f4f6f1; }.thumb { width: 100%; height: 220rpx; background: #e7ece4; }.placeholder { display: flex; align-items: center; justify-content: center; color: #91a08d; }.card-type, .card-title, .card-date { padding: 0 18rpx; }.card-type { margin-top: 18rpx; color: #74826f; font-size: 22rpx; }.card-title { margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; font-weight: 700; }.card-date { padding-bottom: 18rpx; margin-top: 12rpx; color: #849083; font-size: 22rpx; }.state { padding: 120rpx 20rpx; text-align: center; color: #6e7b6c; }.empty-title { margin-bottom: 34rpx; font-size: 31rpx; }.primary-button { background: #4a684c; color: #fff; border-radius: 999rpx; font-size: 30rpx; }.text-button { color: #4a684c; background: transparent; }.text-button::after, .primary-button::after { border: 0; }
