<view class="page">
  <view wx:if="{{profileLoading}}" class="state">正在确认登录状态…</view>

  <block wx:else>
    <view class="profile">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" loading="{{authorizing}}">
        <image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar">照</view>
      </button>
      <view class="profile-info">
        <input class="profile-name-input" type="nickname" value="{{profile.nickName}}" placeholder="点击授权微信昵称" maxlength="40" focus="{{nicknameFocused}}" bindtap="focusNickname" bindinput="onNicknameInput" bindblur="onNicknameBlur" />
        <view class="profile-copy">{{authorized ? '把此刻，好好留住。' : '点击头像和昵称，完成微信资料授权。'}}</view>
      </view>
      <view class="settings" bindtap="openSettings">设置</view>
    </view>

    <view wx:if="{{!authorized}}" class="guest-profile">
      <view class="privacy-copy">仅用于展示你的个人资料，不会公开你的作品。</view>
    </view>

    <block wx:elif="{{loading}}"><view class="state">正在整理作品…</view></block>
    <block wx:elif="{{errorMessage}}"><view class="state"><view>{{errorMessage}}</view><button class="text-button" bindtap="loadRecentWorks">重新加载</button></view></block>
    <block wx:elif="{{!works.length}}"><view class="state empty"><view class="empty-title">第一张照片，正在等一句话。</view><button class="ui-button ui-button-primary" bindtap="startCreation">开始创作</button></view></block>
    <block wx:else>
      <view class="section-head"><view>我的作品（{{totalWorks}}）</view><view class="all-link" bindtap="openAllWorks">查看全部</view></view>
      <view class="grid">
        <view wx:for="{{works}}" wx:key="workId" class="card" data-work-id="{{item.workId}}" bindtap="openWork">
          <image wx:if="{{item.thumbnailUrl}}" class="thumb" src="{{item.thumbnailUrl}}" mode="aspectFill" lazy-load></image>
          <view wx:else class="thumb placeholder">照片</view>
          <view class="card-type">{{item.typeTitle}}</view>
          <view class="card-title">{{item.title}}</view>
          <view class="card-date">{{item.createdLabel}}</view>
        </view>
      </view>
    </block>
  </block>
</view>
