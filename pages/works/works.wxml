<view class="page">
  <view class="hero">
    <view class="eyebrow">照片有话说</view>
    <view class="title ui-page-title">我的作品</view>
    <view class="subtitle">每一张照片，都留下一种说法。</view>
  </view>

  <view wx:if="{{loading}}" class="state">正在整理作品…</view>
  <view wx:elif="{{errorMessage}}" class="state">
    <view>{{errorMessage}}</view>
    <button class="ui-button ui-button-secondary" bindtap="loadWorks">重新加载</button>
  </view>
  <view wx:elif="{{!works.length}}" class="state empty-state">
    <view class="empty-icon">◌</view>
    <view class="empty-title">还没有作品</view>
    <view class="empty-copy">从一张照片开始，写下此刻。</view>
    <button class="ui-button ui-button-primary" bindtap="createAgain">开始创作</button>
  </view>
  <view wx:else class="work-list">
    <view wx:for="{{works}}" wx:key="workId" class="work-card ui-card">
      <view class="work-main" data-work-id="{{item.workId}}" bindtap="openWork">
        <image wx:if="{{item.thumbnailUrl}}" class="thumbnail" src="{{item.thumbnailUrl}}" mode="aspectFill" lazy-load></image>
        <view wx:else class="thumbnail placeholder">照片</view>
        <view class="work-copy">
          <view class="work-meta ui-meta">{{item.typeTitle}} · {{item.createdLabel}}</view>
          <view class="work-title">{{item.title}}</view>
          <view class="work-excerpt">{{item.excerpt}}</view>
        </view>
      </view>
      <view class="delete-button" role="button" aria-label="删除作品" hover-class="delete-button-hover" data-work-id="{{item.workId}}" bindtap="deleteWork">{{deletingWorkId === item.workId ? '…' : '删除'}}</view>
    </view>
    <view wx:if="{{totalPages > 1}}" class="pager">
      <button class="pager-button" disabled="{{page <= 1}}" bindtap="previousPage">上一页</button>
      <view class="pager-status">第 {{page}} / {{totalPages}} 页</view>
      <button class="pager-button" disabled="{{page >= totalPages}}" bindtap="nextPage">下一页</button>
    </view>
  </view>
</view>
