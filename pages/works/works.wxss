page { min-height: 100%; background: #f8f7f2; color: #273025; }
.page { min-height: 100vh; padding: 52rpx 32rpx 72rpx; box-sizing: border-box; }
.hero { margin: 6rpx 0 42rpx; }
.eyebrow { color: #5f725c; font-size: 24rpx; letter-spacing: 5rpx; }
.title { margin-top: 16rpx; }
.subtitle { margin-top: 14rpx; color: #586757; font-size: 28rpx; }
.state { min-height: 56vh; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #687064; font-size: 28rpx; text-align: center; }
.empty-icon { color: #9ea897; font-size: 84rpx; line-height: 1; }
.empty-title { margin-top: 18rpx; color: #3b4638; font-size: 36rpx; }
.empty-copy { margin-top: 14rpx; color: #5d6b59; font-size: 27rpx; }
.empty-state .ui-button, .state .ui-button { margin-top: 38rpx; }
.work-list { display: flex; flex-direction: column; gap: 22rpx; }
.work-card { position: relative; display: flex; align-items: center; gap: 18rpx; padding: 18rpx; }
.work-main { display: flex; flex: 1; min-width: 0; align-items: center; gap: 18rpx; }
.thumbnail { width: 144rpx; height: 144rpx; flex: 0 0 144rpx; border-radius: 16rpx; background: #e5e7df; }
.placeholder { display: flex; align-items: center; justify-content: center; color: #8c9687; font-size: 24rpx; }
.work-copy { min-width: 0; padding-right: 78rpx; }
.work-title { margin-top: 10rpx; overflow: hidden; color: #303b2f; font-size: 31rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.work-excerpt { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: #536352; font-size: 24rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.delete-button { position: absolute; top: 4rpx; right: 4rpx; display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; background: transparent; color: #8d544b; font-size: 20rpx; line-height: 1; }
.delete-button-hover { opacity: .55; }
.pager { display: flex; align-items: center; justify-content: space-between; margin: 18rpx 0 4rpx; padding: 10rpx 4rpx; }
.pager-button { min-width: 128rpx; height: 60rpx; margin: 0; padding: 0 18rpx; border-radius: 30rpx; background: #edf2e9; color: #426145; font-size: 24rpx; line-height: 60rpx; }
.pager-button::after { border: none; }
.pager-button[disabled] { background: #f2f3ef; color: #b0b6ac; }
.pager-status { color: #74806f; font-size: 24rpx; }
