page { min-height: 100%; background: #f8f7f2; color: #273025; }
.page { min-height: 100vh; padding: 52rpx 32rpx 72rpx; box-sizing: border-box; }
.hero { margin: 6rpx 0 42rpx; }
.eyebrow { color: #76826d; font-size: 24rpx; letter-spacing: 5rpx; }
.title { margin-top: 16rpx; font-family: serif; font-size: 56rpx; font-weight: 600; letter-spacing: 2rpx; }
.subtitle { margin-top: 14rpx; color: #74786f; font-size: 28rpx; }
.state { min-height: 56vh; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #687064; font-size: 28rpx; text-align: center; }
.empty-icon { color: #9ea897; font-size: 84rpx; line-height: 1; }
.empty-title { margin-top: 18rpx; color: #3b4638; font-size: 36rpx; }
.empty-copy { margin-top: 14rpx; color: #7a8276; font-size: 27rpx; }
.primary-button, .secondary-button { width: 100%; height: 94rpx; margin-top: 38rpx; border-radius: 48rpx; font-size: 30rpx; }
.primary-button { background: #4a684c; color: #fff; }
.secondary-button { background: #edf2e9; color: #426145; }
.primary-button::after, .secondary-button::after, .delete-button::after { border: none; }
.work-list { display: flex; flex-direction: column; gap: 22rpx; }
.work-card { display: flex; align-items: center; gap: 18rpx; padding: 18rpx; border-radius: 22rpx; background: #fffdf8; box-shadow: 0 10rpx 28rpx rgba(47, 57, 44, .08); }
.work-main { display: flex; flex: 1; min-width: 0; align-items: center; gap: 18rpx; }
.thumbnail { width: 144rpx; height: 144rpx; flex: 0 0 144rpx; border-radius: 16rpx; background: #e5e7df; }
.placeholder { display: flex; align-items: center; justify-content: center; color: #8c9687; font-size: 24rpx; }
.work-copy { min-width: 0; }
.work-meta { color: #788373; font-size: 22rpx; }
.work-title { margin-top: 10rpx; overflow: hidden; color: #303b2f; font-size: 31rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.work-excerpt { display: -webkit-box; margin-top: 8rpx; overflow: hidden; color: #697366; font-size: 24rpx; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.delete-button { flex: 0 0 auto; margin: 0; padding: 12rpx; background: transparent; color: #9a5b4e; font-size: 23rpx; line-height: 1; }
