<view class="page">
  <view wx:if="{{loading}}" class="center-state">正在打开作品…</view>

  <view wx:elif="{{hasError}}" class="center-state">
    <view>{{errorMessage}}</view>
    <button class="primary-button" bindtap="createAgain">返回创作页</button>
  </view>

  <view wx:else class="content">
    <view class="eyebrow">照片有话说 · {{typeTitle}}</view>
    <image class="photo" src="{{work.imageUrl}}" mode="widthFix" show-menu-by-longpress></image>

    <view wx:if="{{work.type === 'poem'}}" class="paper poem-paper">
      <view class="poem-title">{{work.content.poem.title}}</view>
      <view wx:for="{{work.content.poem.lines}}" wx:key="*this" class="poem-line">{{item}}</view>
    </view>

    <view wx:elif="{{work.type === 'review'}}" class="paper">
      <view class="content-title">{{work.content.review.headline}}</view>
      <view class="body">{{work.content.review.body}}</view>
      <view class="tag-list"><text wx:for="{{work.content.review.observations}}" wx:key="*this" class="tag">{{item}}</text></view>
    </view>

    <view wx:else class="paper">
      <view class="label">{{work.content.copy.label}}</view>
      <view class="content-title">{{work.content.copy.headline}}</view>
      <view class="body">{{work.content.copy.body}}</view>
      <view class="tag-list"><text wx:for="{{work.content.copy.hashtags}}" wx:key="*this" class="tag">{{item}}</text></view>
    </view>

    <view wx:if="{{shareImageUrl}}" class="share-preview">
      <view class="share-preview-title">分享成品图</view>
      <image class="share-image" src="{{shareImageUrl}}" mode="widthFix" show-menu-by-longpress></image>
    </view>

    <view wx:if="{{!isShared}}" class="actions">
      <button wx:if="{{shareToken}}" class="primary-button" open-type="share">发给好友</button>
      <button wx:elif="{{shareLoading}}" class="primary-button" disabled>正在生成分享图…</button>
      <button wx:else class="primary-button" bindtap="retryShareCard">生成分享图</button>
      <view wx:if="{{shareError}}" class="share-error">{{shareError}}</view>
      <button class="secondary-button" bindtap="showShareTimelineHint">分享到朋友圈</button>
      <button class="secondary-button" bindtap="saveShareImage">保存分享图</button>
      <button wx:if="{{isFresh}}" class="text-button" bindtap="rewriteSameImage">{{work.type === 'poem' ? '重写一首' : work.type === 'review' ? '换个角度' : '换一条'}}</button>
      <button wx:if="{{isFresh}}" class="text-button" bindtap="createAgain">换一张照片</button>
      <button class="danger-button" loading="{{deleting}}" disabled="{{deleting}}" bindtap="deleteWork">删除这份作品</button>
    </view>

    <view wx:else class="actions">
      <button class="primary-button" bindtap="createAgain">我也要创作</button>
    </view>
  </view>
</view>
