<view class="page">
  <view wx:if="{{loading}}" class="center-state">正在打开作品…</view>

  <view wx:elif="{{hasError}}" class="center-state">
    <view>{{errorMessage}}</view>
    <button class="ui-button ui-button-primary" bindtap="createAgain">返回创作页</button>
  </view>

  <view wx:else class="content">
    <view class="photo-stage"><image class="photo" src="{{work.imageUrl}}" mode="aspectFit" style="width: {{photoWidth}}rpx; height: {{photoHeight}}rpx;" bindload="onPhotoLoad" bindtap="previewPhoto" show-menu-by-longpress></image></view>

    <view wx:if="{{work.type === 'poem'}}" class="paper poem-paper ui-card">
      <view class="poem-title">{{work.content.poem.title}}</view>
      <view wx:for="{{work.content.poem.lines}}" wx:key="*this" class="poem-line">{{item}}</view>
    </view>

    <view wx:elif="{{work.type === 'review'}}" class="paper ui-card">
      <view class="content-title">{{work.content.review.headline}}</view>
      <view class="body">{{work.content.review.body}}</view>
      <view class="tag-list"><text wx:for="{{work.content.review.observations}}" wx:key="*this" class="tag">{{item}}</text></view>
    </view>

    <view wx:else class="paper ui-card">
      <view class="label">{{work.content.copy.label}}</view>
      <view class="content-title">{{work.content.copy.headline}}</view>
      <view class="body">{{work.content.copy.body}}</view>
      <view class="tag-list"><text wx:for="{{work.content.copy.hashtags}}" wx:key="*this" class="tag">{{item}}</text></view>
    </view>

    <view wx:if="{{!isShared}}" class="actions action-grid">
      <view class="action-button" role="button" hover-class="action-button-hover" bindtap="rewriteSameImage">重新创作</view>
      <view class="action-button" role="button" hover-class="action-button-hover" bindtap="createAgain">换图再写</view>
      <view class="action-button share-button" role="button" hover-class="action-button-hover" bindtap="openNativeShareMenu">保存分享</view>
    </view>

    <view wx:else class="actions">
      <button class="ui-button ui-button-primary" bindtap="createAgain">我也要创作</button>
    </view>

  </view>
  <bottom-nav active="create"></bottom-nav>
</view>
