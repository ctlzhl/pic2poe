/* pages/result/result.wxss */
page {
  height: 100vh;
  background: linear-gradient(125deg, #fdf5e7 0%, #efe0cd 100%);
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
}

/* 头部 */
.header {
  text-align: center;
  margin-bottom: 40rpx;
  margin-top: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 36rpx;
  background: linear-gradient(120deg, #b8783c 0%, #deb476 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin: 20rpx 0;
  letter-spacing: 6rpx;
}

/* 结果内容 */
.result-content {
  flex: 1;
  width: 100%;
  max-width: 720rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

.content-block {
  width: 100%;
}

.image-block {
  width: 100%;
  background: #fffdf7;
  border: 2rpx solid rgba(185, 120, 60, 0.2);
  border-radius: 30rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(89, 60, 34, 0.16);
}

.image-wrapper {
  width: 100%;
  position: relative;
  border-radius: 26rpx;
  overflow: hidden;
}

.result-image {
  width: 100%;
  display: block;
}

/* 古诗展示 */
.poem-display {
  width: 100%;
  background: #fff9f1;
  border-radius: 26rpx;
  padding: 44rpx 36rpx;
  box-shadow: 0 20rpx 40rpx rgba(74, 51, 31, 0.14);
  border: 2rpx solid rgba(166, 109, 58, 0.35);
}

.poem-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #3c2516;
  margin-bottom: 24rpx;
  text-align: center;
  letter-spacing: 4rpx;
}

.poem-content {
  font-size: 36rpx;
  color: #553a29;
  line-height: 2;
  text-align: center;
  letter-spacing: 4rpx;
  white-space: pre-line;
  font-family: 'Songti SC', 'STKaiti', 'KaiTi', serif;
}

/* 按钮组 */
.action-buttons {
  width: 100%;
  display: flex;
  gap: 20rpx;
  margin: 20rpx 0 10rpx;
}

.btn-primary,
.btn-secondary,
.btn-share {
  flex: 1;
  height: 90rpx;
  border-radius: 46rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  text-align: center;
  gap: 12rpx;
  font-size: 24rpx;
  border: none;
}

.btn-primary::after,
.btn-secondary::after,
.btn-share::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(120deg, #c98b5f 0%, #a5683d 100%);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(165, 104, 61, 0.35);
}

.btn-secondary {
  background: #fff9f3;
  color: #a5683d;
  border: 2rpx solid rgba(165, 104, 61, 0.8);
}

.btn-share {
  background: linear-gradient(120deg, #b83c2c 0%, #de7046 100%);
  color: #fff;
  box-shadow: 0 12rpx 30rpx rgba(190, 62, 43, 0.35);
}

.btn-text {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.share-status {
  width: 100%;
  text-align: right;
  font-size: 24rpx;
  color: #7a5a40;
  margin-bottom: 12rpx;
}

.share-status-error {
  color: #b13c2c;
}

/* 错误状态 */
.error-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  text-align: center;
}

.error-icon {
  font-size: 80rpx;
  color: #b83c2c;
  margin-bottom: 40rpx;
}

.error-message {
  font-size: 32rpx;
  color: #3d2a1d;
  margin-bottom: 60rpx;
  line-height: 1.6;
  max-width: 80%;
}

/* 重写蒙层 */
.rewrite-overlay {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(11, 16, 33, 0.72);
  backdrop-filter: blur(14px);
  animation: overlayFadeIn 0.18s ease;
}

.rewrite-overlay__glass {
  width: 80%;
  max-width: 620rpx;
  padding: 48rpx 56rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, rgba(28, 37, 64, 0.9), rgba(23, 30, 52, 0.78));
  border: 2rpx solid rgba(163, 199, 255, 0.26);
  box-shadow: 0 28rpx 64rpx rgba(7, 12, 26, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.rewrite-overlay__text {
  font-size: 32rpx;
  font-weight: 600;
  color: #a3c7ff;
  letter-spacing: 4rpx;
  text-align: center;
}

.rewrite-overlay__spinner {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.rewrite-overlay__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #8aa8ff;
  opacity: 0.85;
  animation: dotPulse 1.2s ease-in-out infinite;
}

.rewrite-overlay__dot--1 {
  animation-delay: 0s;
}

.rewrite-overlay__dot--2 {
  animation-delay: 0.18s;
}

.rewrite-overlay__dot--3 {
  animation-delay: 0.36s;
}

@keyframes dotPulse {
  0% {
    transform: translateY(0);
    opacity: 0.4;
  }
  50% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
  100% {
    transform: translateY(0);
    opacity: 0.4;
  }
}

@keyframes overlayFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

