page { min-height: 100%; background: #f8f7f2; color: #273025; }
.page { min-height: 100vh; }
.center-state { min-height: 100vh; padding: 0 56rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #667062; font-size: 30rpx; text-align: center; }
.content { padding: 50rpx 32rpx 72rpx; }
.eyebrow { margin-bottom: 28rpx; color: #71816d; font-size: 24rpx; letter-spacing: 3rpx; }
.photo { width: 100%; border-radius: 24rpx; background: #e5e7df; }
.paper { margin-top: 26rpx; padding: 42rpx 36rpx; border-radius: 22rpx; background: #fffdf8; box-shadow: 0 12rpx 32rpx rgba(47, 57, 44, .09); }
.poem-paper { text-align: center; font-family: 'Songti SC', 'STKaiti', serif; }
.poem-title, .content-title { color: #2e392d; font-size: 42rpx; font-weight: 600; line-height: 1.35; }
.poem-title { margin-bottom: 26rpx; }
.poem-line { color: #4b5848; font-size: 36rpx; letter-spacing: 8rpx; line-height: 1.9; }
.body { margin-top: 24rpx; color: #4f584d; font-size: 30rpx; line-height: 1.8; white-space: pre-wrap; }
.label { color: #77876f; font-size: 24rpx; letter-spacing: 3rpx; }
.tag-list { margin-top: 28rpx; display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag { padding: 10rpx 18rpx; border-radius: 24rpx; background: #eff4ec; color: #557056; font-size: 24rpx; }
.actions { margin-top: 44rpx; }
.primary-button, .secondary-button { display: flex; align-items: center; justify-content: center; width: 100%; height: 94rpx; padding: 0; line-height: 1; border-radius: 48rpx; font-size: 30rpx; }
.primary-button { background: #4a684c; color: #fff; }
.primary-button[disabled] { background: #aeb9aa; color: #f7f7f5; }
.secondary-button { margin-top: 18rpx; background: #edf2e9; color: #426145; }
.primary-button::after, .secondary-button::after { border: none; }
.action-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.action-button { display: flex; align-items: center; justify-content: center; height: 88rpx; margin: 0; padding: 0 10rpx; color: #426145; background: #edf2e9; border-radius: 20rpx; font-size: 25rpx; line-height: 1; white-space: nowrap; }
.share-button { color: #fff; background: #4a684c; }
.action-button::after { border: none; }
