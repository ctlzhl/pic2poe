page { min-height: 100%; background: #f8f7f2; color: #273025; }
.page { min-height: 100vh; }
.center-state { min-height: 100vh; padding: 0 56rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #667062; font-size: 30rpx; text-align: center; }
.content { padding: 36rpx 32rpx 184rpx; }
.eyebrow { margin-bottom: 22rpx; color: #596e58; font-size: 24rpx; letter-spacing: 3rpx; }
.photo-stage { display: flex; align-items: center; justify-content: center; min-height: 280rpx; border-radius: 22rpx; background: #e5e7df; overflow: hidden; }
.photo { display: block; border-radius: 18rpx; }
.photo-hint { margin-top: 10rpx; color: #5b6b59; font-size: 24rpx; text-align: center; }
.paper { margin-top: 20rpx; padding: 36rpx 32rpx; }
.poem-paper { text-align: center; font-family: 'Songti SC', 'STKaiti', serif; }
.poem-title, .content-title { color: #2e392d; font-size: 42rpx; font-weight: 600; line-height: 1.35; }
.poem-title { margin-bottom: 26rpx; }
.poem-line { color: #4b5848; font-size: 36rpx; letter-spacing: 8rpx; line-height: 1.9; }
.body { margin-top: 24rpx; color: #4f584d; font-size: 30rpx; line-height: 1.8; white-space: pre-wrap; }
.label { color: #586e57; font-size: 24rpx; letter-spacing: 3rpx; }
.tag-list { margin-top: 28rpx; display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag { padding: 10rpx 18rpx; border-radius: 24rpx; background: #eff4ec; color: #557056; font-size: 24rpx; }
.actions { margin-top: 44rpx; }
.action-grid { display: flex; align-items: center; width: 100%; padding: 0 8rpx; box-sizing: border-box; }
.action-button { display: flex; flex: 1 1 0; align-items: center; justify-content: center; width: 0; min-width: 0; height: 88rpx; margin: 0 8rpx; padding: 0; box-sizing: border-box; color: #426145; background: #edf2e9; border-radius: 20rpx; font-size: 24rpx; line-height: 1; white-space: nowrap; }
.action-button:first-child { margin-left: 0; }
.action-button:last-child { margin-right: 0; }
.action-button-hover { opacity: .78; }
.share-button { color: #fff; background: #4a684c; }
