page { background: #f8f7f2; }
.page { min-height: 100vh; padding: 30rpx 32rpx 80rpx; box-sizing: border-box; }
.category-scroll { margin: 0 -32rpx 30rpx; width: 750rpx; white-space: nowrap; }
.category-tabs { display: inline-flex; gap: 16rpx; padding: 0 32rpx; }
.category-chip { padding: 14rpx 24rpx; border: 1rpx solid #dbe3d6; border-radius: 999rpx; background: #fff; color: #71806d; font-size: 25rpx; line-height: 1; }
.category-chip.is-active { border-color: #4f704f; background: #4f704f; color: #fff; }
.list { display: flex; flex-direction: column; gap: 30rpx; }.post { overflow: hidden; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 24rpx rgba(50, 60, 47, .06); }.cover { width: 100%; height: 330rpx; background: #e6ebe3; }.placeholder { display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 8rpx; background: linear-gradient(145deg, #dce5d7, #f2ede2); color: #70836f; }.placeholder-mark { font-size: 48rpx; line-height: 1; }.placeholder-label { font-size: 24rpx; letter-spacing: 4rpx; }.meta { margin: 22rpx 24rpx 0; color: #7d8977; font-size: 22rpx; }.title { margin: 12rpx 24rpx 0; color: #293428; font-size: 34rpx; font-weight: 600; }.excerpt { display: -webkit-box; margin: 14rpx 24rpx 26rpx; overflow: hidden; color: #6f786b; font-size: 26rpx; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }.state, .footer { padding: 90rpx 20rpx; color: #7c8578; font-size: 27rpx; text-align: center; }.footer { padding: 28rpx; }.more, .retry { color: #4f704f; }
