page { min-height: 100%; background: #f2f4ec; color: #253025; }
.page { min-height: 100vh; overflow: hidden; position: relative; }
.orb { position: absolute; top: -220rpx; right: -170rpx; width: 620rpx; height: 620rpx; border-radius: 50%; background: #dce8d6; opacity: .75; }
.content { position: relative; padding: 180rpx 56rpx 184rpx; text-align: center; }
.eyebrow { color: #72806d; font-size: 24rpx; letter-spacing: 5rpx; }
.title { margin-top: 28rpx; font-family: serif; font-size: 64rpx; font-weight: 600; }
.status-copy { margin: 22rpx auto 0; max-width: 500rpx; color: #6d756c; font-size: 30rpx; line-height: 1.6; }
.loader-wrap { margin-top: 108rpx; }
.loader { width: 114rpx; height: 114rpx; margin: 0 auto; border: 8rpx solid #d3dfcf; border-top-color: #507454; border-radius: 50%; animation: turn 1s linear infinite; }
.hint { margin-top: 34rpx; color: #899188; font-size: 25rpx; }
.failure-card { margin-top: 88rpx; padding: 34rpx; border-radius: 22rpx; background: #fff; color: #6a5148; font-size: 28rpx; line-height: 1.6; box-shadow: 0 10rpx 30rpx rgba(44, 54, 43, .08); }
.attempt { margin-top: 12rpx; color: #9b8c84; font-size: 23rpx; }
.success-countdown { margin-top: 26rpx; color: #77876f; font-size: 25rpx; }
.primary-button, .secondary-button { display: flex; align-items: center; justify-content: center; width: 100%; height: 96rpx; padding: 0; line-height: 1; border-radius: 48rpx; font-size: 30rpx; }
.primary-button { margin-top: 54rpx; color: #fff; background: #4a684c; }
.secondary-button { margin-top: 20rpx; color: #526451; background: transparent; }
.primary-button::after, .secondary-button::after { border: none; }
@keyframes turn { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
