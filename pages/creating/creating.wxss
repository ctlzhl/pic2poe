page { min-height: 100%; background: #f2f4ec; color: #253025; }
.page { min-height: 100vh; overflow: hidden; position: relative; }
.orb { position: absolute; top: -220rpx; right: -170rpx; width: 620rpx; height: 620rpx; border-radius: 50%; background: #dce8d6; opacity: .75; }
.content { position: relative; padding: 82rpx 48rpx 184rpx; text-align: center; }
.eyebrow { color: #596f59; font-size: 24rpx; letter-spacing: 5rpx; }
.title { margin-top: 24rpx; font-family: serif; font-size: 60rpx; font-weight: 600; }
.status-copy { margin: 16rpx auto 0; max-width: 540rpx; color: #4f6250; font-size: 29rpx; line-height: 1.55; }
.work-context { display: flex; align-items: center; gap: 22rpx; margin-top: 48rpx; padding: 18rpx; border: 1rpx solid #dce5d8; border-radius: 22rpx; background: rgba(255, 255, 255, .88); text-align: left; }
.context-photo { width: 104rpx; height: 104rpx; flex: 0 0 104rpx; border-radius: 14rpx; background: #e5e9e0; }
.context-copy { color: #2c3c2d; font-size: 28rpx; font-weight: 600; }
.context-note { margin-top: 8rpx; color: #576b57; font-size: 24rpx; font-weight: 400; }
.loader-wrap { margin-top: 50rpx; }
.loader { width: 76rpx; height: 76rpx; margin: 0 auto; border: 7rpx solid #d3dfcf; border-top-color: #507454; border-radius: 50%; animation: turn 1s linear infinite; }
.progress-track { height: 12rpx; margin-top: 42rpx; overflow: hidden; border-radius: 6rpx; background: #d8e0d3; }
.progress-fill { height: 100%; border-radius: 6rpx; background: #4a684c; transition: width .3s ease; }
.hint { margin-top: 22rpx; color: #5b6e59; font-size: 25rpx; }
.slow-message { margin-top: 22rpx; color: #6a5b4f; font-size: 25rpx; line-height: 1.5; }
.reconnect-action { display: flex; align-items: center; justify-content: center; width: 180rpx; min-height: 64rpx; margin: 14rpx auto 0; padding: 0 18rpx; border: 1rpx solid #9caf98; border-radius: 32rpx; color: #355e3a; font-weight: 600; }
.failure-card { margin-top: 48rpx; padding: 28rpx; border: 1rpx solid #ecd9d1; border-radius: 22rpx; background: #fffaf7; color: #6a5148; font-size: 28rpx; line-height: 1.6; }
.attempt { margin-top: 12rpx; color: #705f57; font-size: 24rpx; }
.success-countdown { margin-top: 30rpx; color: #536e51; font-size: 25rpx; }
.primary-button { margin-top: 42rpx; }
.secondary-button { margin-top: 16rpx; }
@keyframes turn { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
