.bottom-nav {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: calc(104rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: rgba(253, 251, 251, .98);
  box-shadow: 0 -2rpx 14rpx rgba(42, 57, 40, .05);
}

.bottom-nav-item {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-width: 0;
  color: #71816e;
  font-size: 26rpx;
  line-height: 1;
}

.bottom-nav-item.is-active {
  color: #426044;
  font-weight: 600;
}
